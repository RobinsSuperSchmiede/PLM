POSTGRES_DB=plm
POSTGRES_USER=plm
POSTGRES_PASSWORD=plm
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
NEXT_PUBLIC_API_URL=http://localhost:8000
# Sign-in: "multi" (default) = username + password, every account has its own workspace;
# "single" = no accounts and no sign-in, one local workspace (only where nobody else can reach the machine).
AUTH_MODE=multi
# Databases and uploads of the additional accounts (SQLite) and the accounts store.
# WORKSPACES_DIR=data/workspaces
# Days a sign-in stays valid without use.
# SESSION_DAYS=30
API_PORT=8000
LOG_LEVEL=INFO
# Optional: full SQLAlchemy URL instead of the POSTGRES_* values (e.g. sqlite:///./plm.sqlite3)
# DATABASE_URL=
# URL the web app uses server-side to reach the API (proxy for /api/v1 and /mcp)
API_INTERNAL_URL=http://localhost:8000
# Optional extra hostnames allowed to reach the API/MCP directly, JSON list
# MCP_ALLOWED_HOSTS=["plm.lan"]
# Background loop for reminders, daily summary and the Telegram bot (true by default).
# SCHEDULER_ENABLED=true

{
  "name": "plm",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "cd apps/api && python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "lint:web": "npm --prefix apps/web run lint",
    "build:web": "npm --prefix apps/web run build"
  }
}

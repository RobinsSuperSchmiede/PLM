{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd apps\\api && set DATABASE_URL=sqlite:///./data/plm-dev.sqlite3&& .venv\\Scripts\\python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000"],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/web", "run", "dev"],
      "port": 3000
    }
  ]
}

POSTGRES_DB=plm
POSTGRES_USER=plm
POSTGRES_PASSWORD=plm
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
API_PORT=8000
LOG_LEVEL=INFO
# Sign-in: "multi" (default) = username + password, every account has its own workspace;
# "single" = no accounts and no sign-in, one local workspace (only where nobody else can reach the machine).
AUTH_MODE=multi
# Databases and uploads of the additional accounts (SQLite) and the accounts store.
# WORKSPACES_DIR=data/workspaces
# Days a sign-in stays valid without use.
# SESSION_DAYS=30

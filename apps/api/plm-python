#!/bin/sh
# Python for the desktop app (openshell.json runs "plm-python ..."), also when the app is started from
# the desktop with a short PATH (macOS apps do not see Homebrew's folders). PLM_PYTHON overrides.
# Only Python 3.11 or newer counts. Without one, scripts/runtimes/ensure.sh downloads a portable
# Python once into the app's data folder. PLM_DOWNLOAD_RUNTIMES=1 skips the search.
# Needs the executable bit (git add --chmod=+x apps/api/plm-python).
if [ -z "${PLM_DOWNLOAD_RUNTIMES:-}" ]; then
  for candidate in "${PLM_PYTHON:-}" python3 python /opt/homebrew/bin/python3 /usr/local/bin/python3 /usr/bin/python3; do
    [ -n "$candidate" ] || continue
    command -v "$candidate" >/dev/null 2>&1 || continue
    if "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 11))' >/dev/null 2>&1; then
      exec "$candidate" "$@"
    fi
  done
fi
here="$(cd "$(dirname "$0")" && pwd)"
if python="$(sh "$here/../../scripts/runtimes/ensure.sh" python)"; then
  exec "$python" "$@"
fi
echo "Python 3.11 or newer was not found and could not be downloaded. Install it, or set PLM_PYTHON." >&2
exit 127
